# Narratron 環境變數範本（不含密鑰實值）
# 複製：cp .env.example .env

# State Vault — PostgreSQL + JSONB
# memory：單元測試 / 無 Docker；postgres：對應 docker compose
VAULT_BACKEND=memory
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=narratron_vault
POSTGRES_USER=narratron
POSTGRES_PASSWORD=narratron
DATABASE_URL=postgresql://narratron:narratron@localhost:5432/narratron_vault

# 快取層 — Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# 向量中樞 — Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_URL=http://localhost:8000

# API 閘道
NARRATRON_API_HOST=0.0.0.0
NARRATRON_API_PORT=8080
CHARACTEROS_PANEL_URL=http://localhost:8001/admin/panel

# Character Passport 本機版本庫
CHARPASS_STORE_DIR=data/charpasses

# CharacterOS（角色控制子系統；埠避開 Chroma 8000 / API 閘道 8080）
CHARACTEROS_DATABASE_URL=postgresql://narratron:narratron@localhost:5432/characteros
CHARACTEROS_API_HOST=0.0.0.0
CHARACTEROS_API_PORT=8001

# CharacterOS 第三方生圖（可插拔；預設 null 不打網路）
# provider：null | http | openai | wan
# wan 使用百煉原生 multimodal-generation API（見 characteros/imaging/providers/wan.py）
CHARACTEROS_IMAGE_GEN_PROVIDER=null
CHARACTEROS_IMAGE_GEN_ENDPOINT=
# compatible-mode 根網址；wan provider 會自動換算為 …/api/v1/services/aigc/multimodal-generation/generation
CHARACTEROS_OPENAI_IMAGES_BASE_URL=https://token-plan.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
CHARACTEROS_OPENAI_IMAGES_MODEL=wan2.7-image-pro
# 生圖 API Key（亦可用 PUT /api/v1/admin/imaging-config 寫入 DB）
# CHARACTEROS_IMAGE_GEN_API_KEY=
# OPENAI_API_KEY=
